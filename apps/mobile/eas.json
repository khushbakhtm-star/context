{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.19.0",
      "pnpm": "11.25.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "standalone"
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "standalone"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "wear-preview": {
      "extends": "base",
      "distribution": "internal",
      "credentialsSource": "remote",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_CONTEXT_DISTRIBUTION": "store",
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "standalone",
        "CONTEXT_WEAR_BUILD": "1"
      },
      "android": {
        "gradleCommand": ":wear:test :wear:assembleRelease",
        "applicationArchivePath": "android/wear/build/outputs/apk/release/*.apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_CONTEXT_DISTRIBUTION": "store"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "google-play": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "google-play"
      }
    },
    "apple-app-store": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "apple-app-store"
      }
    },
    "fdroid-preview": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_CONTEXT_DISTRIBUTION": "fdroid",
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "standalone"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "wear-phone-preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "credentialsSource": "remote",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_CONTEXT_DISTRIBUTION": "store",
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "standalone-wear"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    },
    "google-play": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "apple-app-store": {
      "ios": {}
    }
  }
}
