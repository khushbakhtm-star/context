{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.19.0",
      "pnpm": "11.25.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "standalone"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "standalone"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_CONTEXT_DISTRIBUTION": "store"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "google-play": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "google-play"
      }
    },
    "apple-app-store": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "apple-app-store"
      }
    },
    "fdroid-preview": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_CONTEXT_DISTRIBUTION": "fdroid",
        "EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL": "standalone"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal", "releaseStatus": "draft" },
      "ios": {}
    },
    "google-play": {
      "android": { "track": "internal", "releaseStatus": "draft" }
    },
    "apple-app-store": {
      "ios": {}
    }
  }
}
