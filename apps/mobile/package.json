{
  "name": "context-mobile",
  "version": "0.1.9",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "main": "index.ts",
  "scripts": {
    "eas-build-pre-install": "node scripts/prepare-fdroid.cjs --eas-pre-install",
    "start": "expo start --dev-client",
    "start:lan": "expo start --dev-client --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.cjs"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-navigation-bar": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
