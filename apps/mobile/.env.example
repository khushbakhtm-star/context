EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT=common
EXPO_PUBLIC_MICROSOFT_REDIRECT_URI=context://oauth/microsoft

# Optional public HTTPS feed. Leave unset until release availability is verified.
EXPO_PUBLIC_CONTEXT_RELEASE_MANIFEST_URL=
# Set by the distribution build profile: standalone, fdroid, google-play, apple-app-store.
EXPO_PUBLIC_CONTEXT_RELEASE_CHANNEL=
# Actual numeric Apple App Store app ID, supplied after the store app exists.
EXPO_PUBLIC_CONTEXT_APP_STORE_ID=
# Trusted HTTPS release page for owner-signed standalone APKs, not an F-Droid/Play build.
EXPO_PUBLIC_CONTEXT_STANDALONE_RELEASE_URL=
